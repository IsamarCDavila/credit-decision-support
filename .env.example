# Generate a private local .env with: python scripts/configure_demo.py
CDS_DATABASE_PASSWORD=
CDS_RUNTIME_PASSWORD=
CDS_DEMO_IDENTITIES={}

# OpenAI calls require explicit opt-in; never commit a populated key.
CDS_OPENAI_API_KEY=
CDS_LLM_LIVE_ENABLED=false
CDS_LLM_MODEL=gpt-5.6-terra
CDS_LLM_BUDGET_USD=2.00
CDS_LLM_MAX_CALLS=64

# Opt in only for isolated synthetic demonstration sessions.
CDS_GUIDED_DEMO_ENABLED=false
CDS_PUBLIC_DEMO=false
# Hosted HTTPS origin is supplied by the public supervisor; see docs/public-hosting.md.
CDS_DEMO_REQUESTS_PER_MINUTE=8
CDS_DB_STATEMENT_TIMEOUT_MS=15000
CDS_DB_LOCK_TIMEOUT_MS=5000
CDS_DEMO_SESSION_TTL_SECONDS=1800
CDS_DEMO_MAX_ACTIVE_SESSIONS=20
CDS_DEMO_MAX_SESSIONS=200

        "properties": {
          "segment": {
            "type": "string",
            "const": "SME",
            "title": "Segment"
          },
          "currency": {
            "type": "string",
            "const": "USD",
            "title": "Currency"
          },
          "cutoff": {
            "type": "string",
            "format": "date",
            "title": "Cutoff"
          }

  "components": {
    "schemas": {
      "AuditEvent": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "sequence": {
            "type": "integer",
            "title": "Sequence"
          },
          "actor_id": {
            "type": "string",
            "title": "Actor Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          },
          "previous_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Previous Hash"
          },
          "event_hash": {
            "type": "string",
            "title": "Event Hash"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "sequence",
          "actor_id",
          "kind",
          "payload",
          "previous_hash",
          "event_hash",
          "created_at"
        ],
        "title": "AuditEvent"
      },
      "AuditPage": {
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/AuditEvent"
            },
            "type": "array",
            "title": "Events"
          },
          "next_after_sequence": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next After Sequence"
          }
        },
        "type": "object",
        "required": [
          "events",
          "next_after_sequence"
        ],
        "title": "AuditPage"
      },
      "CaseView": {
        "properties": {
          "segment": {
            "type": "string",
            "const": "SME",
            "title": "Segment"
          },
          "currency": {
            "type": "string",
            "const": "USD",
            "title": "Currency"
          },
          "cutoff": {
            "type": "string",
            "format": "date",
            "title": "Cutoff"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },

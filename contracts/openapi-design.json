          },
          "422": {
            "description": "Error; see docs/domain.md"
          },
          "503": {
            "description": "Error; see docs/domain.md"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "segment",
                  "currency",
                  "cutoff"
                ],
                "type": "object",
                "properties": {
                  "cutoff": {
                    "format": "date",
                    "type": "string"
                  },
                  "currency": {
                    "const": "USD"
                  },
                  "segment": {
                    "const": "SME"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "required": true
        }

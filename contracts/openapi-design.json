        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "evaluation_id",
                  "expected_review_state",
                  "decision",
                  "reason"
                ],
                "type": "object",
                "properties": {
                  "evaluation_id": {
                    "format": "uuid",
                    "type": "string"
                  },
                  "decision": {
                    "enum": [
                      "APPROVED",
                      "REJECTED",
                      "NEEDS_MORE_INFO"
                    ],
                    "type": "string"
                  },
                  "reason": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "expected_review_state": {
                    "const": "PENDING"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "required": true
        }

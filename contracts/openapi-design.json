        "parameters": [
          {
            "required": true,
            "in": "header",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "name": "Idempotency-Key"
          }
        ],
        "responses": {
          "201": {
            "description": "Create synthetic SME USD case"
          },
          "400": {
            "description": "Error; see docs/domain.md"
          },
